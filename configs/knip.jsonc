{
  "$schema": "https://unpkg.com/knip@5/overview/config.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/pages/**/*.{ts,tsx}",
    "src/index.{ts,tsx}",
    "src/main.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "@types/*",
    "postcss",
    "tailwindcss"
  ]
}
